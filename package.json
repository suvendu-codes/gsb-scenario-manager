{
  "name": "gsb-scenario-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build-service": "turbo run build typecheck lint test --filter=core-service",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-angular": "^21.2.3",
    "husky": "9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.5.0"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,mjs,json,css,md}": [
      "pnpm --filter web exec prettier --write"
    ]
  }
}

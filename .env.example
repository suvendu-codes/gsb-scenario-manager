# Copy to .env at the repo root:
#   cp .env.example .env

# --- core-service ---
NODE_ENV=
PORT=
BFF_SERVICE_URL=
MAP_API=
RUN_ENGINE_URL=
# CSRF trusted origins (scheme://host[:port], no path). Dev localhost is added when NODE_ENV != production.
DEV_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=

# --- Postgres (docker compose: postgres service) ---
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_POOL_MAX=
DATABASE_URL=

# --- Redis (docker compose: redis service) ---
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# --- Kafka (docker compose: kafka service) ---
KAFKA_BROKERS=
KAFKA_CLIENT_ID=
KAFKA_SSL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Trigger topic per engine (defaults: sm.emulator.commands / sm.simulator.commands)
KAFKA_TOPIC_EMULATOR_COMMANDS=
KAFKA_TOPIC_SIMULATOR_COMMANDS=
EVENT_SCHEMA_VERSION=

# --- Outbox worker (defaults in src/config.ts) ---
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_LEASE_MS=
OUTBOX_BACKOFF_BASE_MS=
OUTBOX_BACKOFF_MAX_MS=
# 0 = retry broker outages forever; non-retriable errors always park the row as dead
OUTBOX_MAX_ATTEMPTS=

# --- module tests (pnpm --filter core-service test:module) ---
MODULE_TEST_DATABASE_URL=
MODULE_TEST_KAFKA_BROKERS=

# --- web (optional) ---
# NEXT_PUBLIC_API_URL=

# Copy to .env at the repo root:
#   cp .env.example .env

# --- core-service ---
NODE_ENV=
PORT=
BFF_SERVICE_URL=
MAP_API=
RUN_ENGINE_URL=
# CSRF trusted origins (scheme://host[:port], no path). Dev localhost is added when NODE_ENV != production.
DEV_ORIGIN=http://localhost:3000
FRONTEND_ORIGIN=

# --- Scenario config (GCS) ---
# Config blobs may only be read from gs://<SCENARIO_CONFIG_BUCKET>/<SCENARIO_CONFIG_PREFIX>...
# The bucket is required for the GCS reader to accept any configUri; the prefix is optional (e.g. scenarios/).
SCENARIO_CONFIG_BUCKET=
SCENARIO_CONFIG_PREFIX=

# --- Postgres (docker compose: postgres service) ---
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_POOL_MAX=
DATABASE_URL=

# --- Redis (docker compose: redis service) ---
REDIS_HOST=
REDIS_PORT=
REDIS_URL=

# --- web (optional) ---
# NEXT_PUBLIC_API_URL=

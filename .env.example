# Copy to .env and fill in values.
# cp .env.example .env

# --- GCP ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- GCP Managed Kafka (bff-service consumer) ---
# Run: ./scripts/setup-gcp-kafka.sh
KAFKA_CLUSTER_ID=scene-kafka
KAFKA_LOCATION=us-central1
# From: gcloud managed-kafka clusters describe CLUSTER --location=REGION --format='value(bootstrapAddress)'
KAFKA_BROKERS=bootstrap.scene-kafka.us-central1.managedkafka.your-gcp-project-id.cloud.goog:9092
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=oauthbearer
KAFKA_CONSUMER_GROUP_ID=bff-live

# Optional PLAIN fallback (e.g. quick test with gcloud auth print-access-token):
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=you@example.com
# KAFKA_SASL_PASSWORD=$(gcloud auth print-access-token)

# --- Local infra (docker compose) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
DB_USER=scene
DB_PASSWORD=scene
DB_NAME=scene
DB_HOST=localhost
DB_PORT=5432
# Pgpool-II (docker compose) fronts postgres on this port; point DATABASE_URL at 5433 to use it.
# PGPOOL_PORT=5433
# PgBouncer (docker compose, transaction pooling) fronts postgres. App traffic uses 6432.
# PGBOUNCER_PORT=6432
# Direct Postgres is 5432 (migrations). Through PgBouncer:
# DATABASE_URL=postgresql://scene:scene@localhost:6432/scene
# Overrides DB_* when set. Defaults match docker compose.
DATABASE_URL=postgresql://scene:scene@localhost:5432/scene

# --- Services ---
PORT=3001
CORE_SERVICE_URL=http://localhost:3002
BFF_SERVICE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Dummy map API called by core GET /map through the circuit breaker
MAP_API=https://jsonplaceholder.typicode.com/todos/1

# --- Upstream (dummy) APIs served by core-service under /upstream ---
# Stand-ins for Foundry GraphQL + GSB-BFF until real upstreams are wired.
# Swap UPSTREAM_API_BASE for the real host (e.g. https://gsb.greymatter.greyorange.com/gsb-bff/api/v1) to go live.
UPSTREAM_API_BASE=http://localhost:3002/upstream
UPSTREAM_PROJECTS_API=http://localhost:3002/upstream/projects
UPSTREAM_SOLUTIONS_API=http://localhost:3002/upstream/projects/{projectId}/solutions
UPSTREAM_AGENT_OPERATIONS_API=http://localhost:3002/upstream/agent-operations
UPSTREAM_MAPS_API=http://localhost:3002/upstream/solutions/{siteId}/functional-areas/{functionalAreaId}/agents/{agentId}/maps
